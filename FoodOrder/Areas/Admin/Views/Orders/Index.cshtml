@model FoodOrder.ViewModels.OrderListViewModel
@{
    ViewData["Title"] = "Đơn hàng";
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Đơn hàng</h4>
    <span class="text-muted">@Model.TotalItems đơn</span>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">Trạng thái</label>
        <select name="status" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var status in statuses)
            {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Tìm theo mã đơn / tên bàn</label>
        <input type="text" name="keyword" value="@Model.Keyword" class="form-control" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a>
    </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Bàn</th>
                <th>Thời gian</th>
                <th class="text-center">Món</th>
                <th>Thanh toán</th>
                <th>Trạng thái</th>
                <th class="text-end">Tổng tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Items)
        {
            <tr>
                <td class="fw-semibold">@row.OrderCode</td>
                <td>@row.TableName @if (!string.IsNullOrWhiteSpace(row.Area)) { <span class="small text-muted">(@row.Area)</span> }</td>
                <td class="small text-muted">@row.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-center">@row.ItemCount</td>
                <td>
                    <div class="small">@row.PaymentMethod</div>
                    <span class="badge @(row.PaymentStatus == "Đã thanh toán" ? "bg-success" : "bg-light text-dark border")">@row.PaymentStatus</span>
                </td>
                <td>
                    <span class="badge @(row.Status == "Hủy" ? "bg-secondary" : row.Status == "Hoàn tất" ? "bg-success" : row.Status == "Chờ thanh toán" ? "bg-warning text-dark" : "bg-info text-dark")">@row.Status</span>
                </td>
                <td class="text-end fw-semibold">@row.TotalAmount.ToVnd()</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Detail" asp-route-id="@row.OrderId">Chi tiết</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info mt-3">Không có đơn phù hợp.</div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-keyword="@Model.Keyword" asp-route-page="@(Model.Page - 1)">Trước</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-status="@Model.Status" asp-route-keyword="@Model.Keyword" asp-route-page="@(Model.Page + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}
