@model FoodOrder.Web.ViewModels.ProductViewModel
@{
  var isEdit = Model.ProductId > 0;
  ViewData["Title"] = isEdit ? "Sửa món" : "Thêm món";
}
<h3>@ViewData["Title"]</h3>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<div asp-validation-summary="All" class="text-danger"></div>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")">
  <input type="hidden" asp-for="ProductId" />
  <input type="hidden" asp-for="RowVersionBase64" />

  <div class="row g-3">
    <div class="col-md-6"><label asp-for="Name" class="form-label">Tên món</label>
      <input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="CategoryId" class="form-label">Danh mục</label>
      <select asp-for="CategoryId" asp-items="@((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories)" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="Price" class="form-label">Giá (đ)</label>
      <input asp-for="Price" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Description" class="form-label">Mô tả</label>
      <textarea asp-for="Description" rows="3" class="form-control"></textarea></div>
    <div class="col-md-3"><label asp-for="Stock" class="form-label">Tồn kho (để trống = không theo dõi)</label>
      <input asp-for="Stock" class="form-control" /></div>
    <div class="col-md-3 pt-4"><div class="form-check">
      <input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable" class="form-check-label">Còn bán</label></div></div>
  </div>

  <div class="mt-3">
    <button class="btn btn-primary">Lưu</button>
    <a class="btn btn-light" asp-action="Index">Quay lại</a>
  </div>
</form>

@if (isEdit)
{
  <div id="product-extras" class="mt-4">
    @await Html.PartialAsync("_Images", (Model.ProductId, (List<FoodOrder.Web.Models.ProductImage>)ViewBag.Images))
  </div>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }