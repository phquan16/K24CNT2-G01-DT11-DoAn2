@model List<FoodOrder.ViewModels.IngredientViewModel>
@{ ViewData["Title"] = "Nguyên liệu"; bool onlyLow = ViewBag.OnlyLow == true; }

<div class="d-flex justify-content-between mb-3">
  <h3>Nguyên liệu &amp; tồn kho</h3>
  <div>
    <a class="btn btn-outline-warning" asp-action="Index" asp-route-onlyLow="@(!onlyLow)">@(onlyLow ? "Xem tất cả" : "Chỉ xem sắp hết")</a>
    <a class="btn btn-primary" asp-action="Create">+ Thêm</a>
  </div>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<table class="table align-middle">
  <thead><tr><th>Tên</th><th>Đơn vị</th><th class="text-end">Tồn</th><th class="text-end">Ngưỡng</th><th>Nhập thêm</th><th></th></tr></thead>
  <tbody>
  @foreach (var i in Model)
  {
    <tr class="@(i.IsLow ? "table-danger" : "")">
      <td>@i.Name @if (i.IsLow) { <span class="badge bg-danger">Sắp hết</span> }</td>
      <td>@i.Unit</td>
      <td class="text-end">@i.StockQty.ToString("0.###")</td>
      <td class="text-end">@i.MinQty.ToString("0.###")</td>
      <td>
        <form asp-action="AddStock" method="post" class="d-flex gap-1">
          <input type="hidden" name="id" value="@i.IngredientId" />
          <input type="hidden" name="rowVersion" value="@i.RowVersionBase64" />
          <input name="qty" type="number" step="0.001" min="0.001" class="form-control form-control-sm" style="width:90px" required />
          <button class="btn btn-sm btn-outline-success">Nhập</button>
        </form>
      </td>
      <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@i.IngredientId">Sửa</a></td>
    </tr>
  }
  </tbody>
</table>