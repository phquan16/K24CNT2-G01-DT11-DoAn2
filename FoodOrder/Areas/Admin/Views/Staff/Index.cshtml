@model List<FoodOrder.ViewModels.StaffRowViewModel>
@{
    ViewData["Title"] = "Nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Nhân viên</h4>
    <a class="btn btn-primary" asp-action="Create">Thêm nhân viên</a>
</div>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.UserName</td>
                <td>@row.FullName</td>
                <td>@row.Email</td>
                <td><span class="badge bg-secondary">@row.Role</span></td>
                <td>
                    @if (row.IsActive)
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Đã khóa</span>
                    }
                </td>
                <td class="text-end">
                    <div class="d-flex gap-1 justify-content-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@row.Id">Sửa</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@row.Id">Đặt lại mật khẩu</a>
                        <form asp-action="Toggle" method="post" onsubmit="return confirm('Đổi trạng thái hoạt động của tài khoản @row.UserName?');">
                            <input type="hidden" name="id" value="@row.Id" />
                            <button type="submit" class="btn btn-sm @(row.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(row.IsActive ? "Khóa" : "Mở khóa")
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info mt-3">Chưa có tài khoản nhân viên.</div>
}
