@model FoodOrder.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<h4 class="mb-3">Đặt lại mật khẩu</h4>
<div class="text-muted mb-3">Tài khoản: <strong>@ViewData["UserName"]</strong></div>

<form asp-action="ResetPassword" method="post" class="bg-white rounded shadow-sm p-3" style="max-width:480px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
        <div class="small text-muted">Tối thiểu 6 ký tự.</div>
    </div>

    <button type="submit" class="btn btn-primary">Đặt lại</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
