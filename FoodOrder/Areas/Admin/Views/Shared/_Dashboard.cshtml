@model FoodOrder.ViewModels.DashboardViewModel

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Doanh thu đã thanh toán</div>
                <div class="fs-4 fw-bold">@Model.RevenueInRange.ToVnd()</div>
                <div class="small text-muted">@Model.PaidOrderCount đơn</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Đơn đang mở</div>
                <div class="fs-4 fw-bold">@Model.OpenOrderCount</div>
                <div class="small text-muted">Chưa hoàn tất hoặc chưa hủy</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Cảnh báo tồn kho</div>
                <div class="fs-4 fw-bold">@Model.LowStockCount</div>
                <a class="small" asp-area="Admin" asp-controller="Ingredients" asp-action="Index">Xem nguyên liệu</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Khoảng thời gian</div>
                <div class="fw-semibold">@Model.From.ToString("dd/MM/yyyy")</div>
                <div class="fw-semibold">@Model.To.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Doanh thu theo ngày</div>
            @if (Model.RevenueByDay.Count == 0)
            {
                <div class="card-body text-muted">Chưa có đơn đã thanh toán trong khoảng này.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th class="text-center">Số đơn</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.RevenueByDay)
                        {
                            <tr>
                                <td>@(row.RevenueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-center">@(row.OrderCount ?? 0)</td>
                                <td class="text-end">@((row.Revenue ?? 0).ToVnd())</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Món bán chạy</div>
            @if (Model.TopProducts.Count == 0)
            {
                <div class="card-body text-muted">Chưa có dữ liệu bán hàng.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Món</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var (row, index) in Model.TopProducts.Select((r, i) => (r, i + 1)))
                        {
                            <tr>
                                <td>@index</td>
                                <td>@row.ProductName</td>
                                <td class="text-center">@(row.TotalQty ?? 0)</td>
                                <td class="text-end">@((row.TotalRevenue ?? 0).ToVnd())</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-3 mt-0">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Khung giờ cao điểm</div>
            @if (Model.PeakHours.Count == 0)
            {
                <div class="card-body text-muted">Chưa có dữ liệu.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Giờ</th>
                                <th class="text-center">Số đơn</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.PeakHours)
                        {
                            var hour = row.HourOfDay ?? 0;
                            <tr>
                                <td>@($"{hour:00}:00 - {hour + 1:00}:00")</td>
                                <td class="text-center">@(row.OrderCount ?? 0)</td>
                                <td class="text-end">@((row.Revenue ?? 0).ToVnd())</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Sử dụng bàn</div>
            @if (Model.TableUsage.Count == 0)
            {
                <div class="card-body text-muted">Chưa có bàn.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Bàn</th>
                                <th>Khu vực</th>
                                <th class="text-center">Số đơn</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.TableUsage)
                        {
                            <tr>
                                <td>@row.TableName</td>
                                <td class="small text-muted">@row.Area</td>
                                <td class="text-center">@(row.OrderCount ?? 0)</td>
                                <td class="text-end">@row.Revenue.ToVnd()</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-header bg-white fw-semibold">Cảnh báo tồn kho thấp</div>
    @if (Model.LowStock.Count == 0)
    {
        <div class="card-body text-muted">Tồn kho đang ở mức an toàn.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Loại</th>
                        <th>Tên</th>
                        <th class="text-end">Hiện tại</th>
                        <th class="text-end">Ngưỡng</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.LowStock)
                {
                    <tr>
                        <td>@row.ItemType</td>
                        <td>@row.ItemName</td>
                        <td class="text-end text-danger">@(row.CurrentQty?.ToString("N2") ?? "-")</td>
                        <td class="text-end">@(row.ThresholdQty?.ToString("N2") ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
