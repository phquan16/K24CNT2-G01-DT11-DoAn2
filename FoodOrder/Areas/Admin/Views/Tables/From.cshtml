@model FoodOrder.ViewModels.TableViewModel
@{ ViewData["Title"] = Model.TableId == 0 ? "Thêm bàn ăn" : "Sửa bàn ăn"; }

<h2>@ViewData["Title"]</h2>

<form asp-action="Save" method="post" class="col-md-6">
    <input type="hidden" asp-for="TableId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="TableCode" class="form-label"></label>
        <input asp-for="TableCode" class="form-control" />
        <span asp-validation-for="TableCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TableName" class="form-label"></label>
        <input asp-for="TableName" class="form-control" />
        <span asp-validation-for="TableName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Area" class="form-label"></label>
        <input asp-for="Area" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a class="btn btn-link" asp-action="Index">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}