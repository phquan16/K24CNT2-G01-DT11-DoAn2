@model FoodOrder.ViewModels.WaiterBoardViewModel
@{
    ViewData["Title"] = "Sơ đồ bàn";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sơ đồ bàn</h4>
    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">Làm mới</button>
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
@foreach (var t in Model.Tables)
{
    <div class="col">
        <div class="card h-100 shadow-sm @(t.ReadyItems > 0 ? "border-success" : "")">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-bold">@t.TableName</div>
                        <div class="small text-muted">Mã @t.TableCode @(string.IsNullOrWhiteSpace(t.Area) ? "" : $"· {t.Area}")</div>
                    </div>
                    <span class="badge @(t.Status == "Đang phục vụ" ? "bg-primary" : t.Status == "Tạm ngưng" ? "bg-secondary" : "bg-light text-dark border")">@t.Status</span>
                </div>
                <div class="small mt-2">
                    <div>Đơn đang mở: <strong>@t.OpenOrders</strong></div>
                    <div>Chưa thu: <strong>@t.UnpaidAmount.ToVnd()</strong></div>
                    @if (t.ReadyItems > 0)
                    {
                        <div class="text-success fw-semibold">@t.ReadyItems món chờ mang ra</div>
                    }
                </div>
            </div>
            <div class="card-footer bg-white">
                <form asp-action="CloseTable" method="post" onsubmit="return confirm('Đóng bàn @t.TableCode? Chỉ đóng được khi không còn đơn chưa hoàn tất.');">
                    <input type="hidden" name="id" value="@t.TableId" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Đóng bàn</button>
                </form>
            </div>
        </div>
    </div>
}
</div>

<div class="card shadow-sm" id="ready">
    <div class="card-header bg-white fw-semibold">Món đã xong, chờ mang ra (@Model.Ready.Count)</div>
    <div class="card-body p-0">
        @if (Model.Ready.Count == 0)
        {
            <div class="p-3 text-muted">Không có món nào đang chờ phục vụ.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Bàn</th>
                            <th>Món</th>
                            <th class="text-center">SL</th>
                            <th>Xong lúc</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Ready)
                    {
                        <tr>
                            <td class="fw-semibold">@row.TableName</td>
                            <td>@row.ProductName</td>
                            <td class="text-center">@row.Quantity</td>
                            <td class="small text-muted">@row.CreatedAt.ToString("HH:mm")</td>
                            <td class="text-end">
                                <form asp-action="Serve" method="post">
                                    <input type="hidden" name="id" value="@row.OrderDetailId" />
                                    <button type="submit" class="btn btn-sm btn-success">Đã phục vụ</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
