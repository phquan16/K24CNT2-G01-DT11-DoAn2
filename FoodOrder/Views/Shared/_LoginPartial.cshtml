@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var roles = user == null ? new List<string>() : (await UserManager.GetRolesAsync(user)).ToList();
    <ul class="navbar-nav align-items-lg-center">
        <li class="nav-item">
            <span class="nav-link text-dark">@(user?.FullName ?? User.Identity?.Name)</span>
        </li>
        <li class="nav-item">
            <span class="badge bg-secondary">@string.Join(", ", roles)</span>
        </li>
        <li class="nav-item">
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link text-dark">Đăng xuất</button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập nhân viên</a>
        </li>
    </ul>
}
