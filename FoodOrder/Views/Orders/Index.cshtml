@model List<FoodOrder.ViewModels.CustomerOrderViewModel>
@{
    ViewData["Title"] = "Đơn của tôi";
    Layout = "_MenuLayout";
    var tableCode = ViewData["TableCode"] as string ?? string.Empty;
    var hasGateway = ViewData["HasGateway"] as bool? ?? false;
}

<h4 class="mb-1">Đơn của tôi</h4>
<div class="text-muted mb-3">Bàn <strong>@ViewData["TableName"]</strong></div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Bạn chưa gửi đơn nào.
        <a asp-controller="Menu" asp-action="Index" asp-route-table="@tableCode">Gọi món ngay</a>.
    </div>
}
else
{
    foreach (var order in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>@order.OrderCode</strong>
                    <span class="text-muted small">· @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge @(order.Status == "Hủy" ? "bg-secondary" : order.Status == "Hoàn tất" ? "bg-success" : order.Status == "Chờ thanh toán" ? "bg-warning text-dark" : "bg-info text-dark")">@order.Status</span>
                    <span class="badge @(order.PaymentStatus == "Đã thanh toán" ? "bg-success" : "bg-light text-dark border")">@order.PaymentStatus</span>
                    <span class="badge bg-light text-dark border">@order.PaymentMethod</span>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-2">
                        <thead>
                            <tr>
                                <th>Món</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>
                                    <div>@item.ProductName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.SelectedOptions))
                                    {
                                        <div class="small text-muted">@item.SelectedOptions</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="small text-muted">Ghi chú: @item.Note</div>
                                    }
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToVnd()</td>
                                <td>
                                    <span class="badge @(item.ItemStatus == "Hủy" ? "bg-secondary" : item.ItemStatus == "Đã phục vụ" ? "bg-success" : item.ItemStatus == "Mới" ? "bg-light text-dark border" : "bg-warning text-dark")">@item.ItemStatus</span>
                                </td>
                                <td class="text-end">
                                    @if (item.CanCancel)
                                    {
                                        <form asp-action="CancelItem" method="post" onsubmit="return confirm('Hủy món này?');">
                                            <input type="hidden" name="table" value="@tableCode" />
                                            <input type="hidden" name="id" value="@item.OrderDetailId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Hủy món</button>
                                        </form>
                                    }
                                    @if (item.CanReview)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Review" asp-action="Edit"
                                           asp-route-productId="@item.ProductId" asp-route-table="@tableCode">Đánh giá</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="2" class="text-end">Tổng đơn</th>
                                <th class="text-end text-danger">@order.TotalAmount.ToVnd()</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (order.Status == "Chờ thanh toán")
                {
                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <span>
                            Đơn chưa thanh toán và sẽ tự hủy sau 15 phút
                            @if (order.ExpiredAt.HasValue)
                            {
                                <span>(hạn lúc @order.ExpiredAt.Value.ToString("HH:mm:ss")).</span>
                            }
                        </span>
                        <span class="d-flex gap-2">
                            @if (hasGateway)
                            {
                                <form asp-action="Pay" method="post">
                                    <input type="hidden" name="table" value="@tableCode" />
                                    <input type="hidden" name="id" value="@order.OrderId" />
                                    <button type="submit" class="btn btn-sm btn-primary">Thanh toán VNPay</button>
                                </form>
                            }
                            <form asp-action="CancelOrder" method="post" onsubmit="return confirm('Hủy đơn này?');">
                                <input type="hidden" name="table" value="@tableCode" />
                                <input type="hidden" name="id" value="@order.OrderId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                            </form>
                        </span>
                    </div>
                    @if (!hasGateway)
                    {
                        <div class="small text-muted">Thanh toán online chưa được cấu hình trên hệ thống.</div>
                    }
                }
                else if (order.PaymentStatus != "Đã thanh toán" && order.Status != "Hủy")
                {
                    <div class="small text-muted">Thanh toán tại quầy khi dùng xong.</div>
                }
            </div>
        </div>
    }
    <a class="btn btn-outline-primary" asp-controller="Menu" asp-action="Index" asp-route-table="@tableCode">Gọi thêm món</a>
}
